VITE_CDP_PROJECT_ID=your-project-id

# Lend: the fee-earning vaults end users deposit into. Create them from the CDP Portal
# on the Morpho catalog, then list them here as catalog:vaultId:vaultAddress,
# comma-separated. catalog is one of steakhouse, gauntlet, clearstar, bitwise.
# The address is optional; it lets the Lend view read each vault's fee, its TVL
# and the user's wallet balance straight from Base.
VITE_CDP_VAULTS=steakhouse:your-vault-id:0x...,gauntlet:your-vault-id:0x...

# Optional: leave unset to use the standard production CDP API.
# VITE_CDP_BASE_PATH=https://your-cdp-api-base-path
